# syntax=docker/dockerfile:1
# The fork's lite image (TheMightyTRex/Reelix, 4 November 2026): the same build as docker/Dockerfile, without
# direct downloads (YouTube, Spotify) or the /api/docs page, and with a stand-alone ffprobe instead of Debian's
# full ffmpeg, Deno and yt-dlp. For films, series, books and music Reelix only runs ffprobe. Radio filing rewraps
# MPEG-TS captures with `ffmpeg -c copy`, so the image has a 3 MB FFmpeg built for that alone (6 November 2026).
#
# Build: docker build -f docker/Dockerfile.lite -t reelix:lite .
# Kept in step with upstream by .github/workflows/lite.yml: only this file and the build options differ.

# Cargo features for reelix-server: empty for lite, "direct,docs" for the full feature set.
ARG REELIX_FEATURES=""
# A static ffprobe, pinned. Change the tag to update it.
ARG FFPROBE_IMAGE=mwader/static-ffmpeg:7.1
# The Reelix version, written into the image's version label so Starboard and other tools can tell which
# version runs, even under the floating "lite" tag (added 5 November 2026). lite.yml passes the release, such as 0.7.1.
ARG VERSION=dev

FROM rust:1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS chef
RUN cargo install --locked cargo-chef
WORKDIR /src

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
ARG REELIX_FEATURES
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --release --locked --recipe-path recipe.json --package reelix-server \
    --no-default-features ${REELIX_FEATURES:+--features "$REELIX_FEATURES"}
COPY . .
RUN cargo build --release --locked --package reelix-server --bin reelix \
    --no-default-features ${REELIX_FEATURES:+--features "$REELIX_FEATURES"} \
    && cp target/release/reelix /reelix

# The web app is the same as upstream's (8 MB on disk, nothing at run time while nobody opens it).
FROM chef AS web
RUN rustup target add wasm32-unknown-unknown \
    && cargo install --locked trunk
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --release --locked --recipe-path recipe.json \
    --target wasm32-unknown-unknown --package reelix-web
COPY . .
RUN cd crates/reelix-web && trunk build --release

FROM ${FFPROBE_IMAGE} AS ffprobe

# FFmpeg for radio filing only: MPEG-TS in, Matroska audio out, audio copied as is (crates/reelix-radio/src/filing.rs).
# No encoders, no network and no video, so it is about 3 MB instead of 135 MB for a full static FFmpeg.
FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS remux
ARG FFMPEG_VERSION=7.1.2
ARG FFMPEG_SHA256=089bc60fb59d6aecc5d994ff530fd0dcb3ee39aa55867849a2bbc4e555f9c304
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils gcc make libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl -sSfL --retry 5 --retry-all-errors --retry-delay 10 --connect-timeout 30 "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" -o ffmpeg.tar.xz \
    && echo "${FFMPEG_SHA256}  ffmpeg.tar.xz" | sha256sum -c - \
    && tar xf ffmpeg.tar.xz --strip-components=1 \
    && ./configure --disable-everything --disable-autodetect --disable-asm --disable-doc --disable-network \
        --disable-ffplay --disable-ffprobe --disable-avdevice --disable-swscale --disable-postproc \
        --enable-small --enable-static --disable-shared \
        --enable-protocol=file --enable-demuxer=mpegts --enable-muxer=matroska --enable-muxer=matroska_audio \
        --enable-parser=aac,aac_latm,mpegaudio,ac3,opus --enable-bsf=aac_adtstoasc \
        --enable-decoder=aac,aac_latm,mp2,mp3,ac3,eac3,opus \
        --extra-ldflags=-static \
    && make -j"$(nproc)" ffmpeg \
    && strip ffmpeg && cp ffmpeg /ffmpeg

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS runtime
ARG VERSION
LABEL org.opencontainers.image.title="Reelix" \
      org.opencontainers.image.version="${VERSION}"
# util-linux (setpriv) is part of the base image; tzdata makes TZ work. The upgrade takes in Debian's
# security fixes released since the pinned base image (such as apt 2.6.2).
# unrar unpacks downloads that hold only RAR archives. It is in Debian's non-free component
# (freeware, free to redistribute) and adds about 0.4 MB.
RUN sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates tzdata unrar \
    && rm -rf /var/lib/apt/lists/*

# --chmod on COPY, not a later RUN chmod, which would store a second copy of each file in a new layer.
COPY --from=ffprobe --chmod=0755 /ffprobe /usr/local/bin/ffprobe
COPY --from=remux --chmod=0755 /ffmpeg /usr/local/bin/ffmpeg
COPY --from=builder --chmod=0755 /reelix /app/reelix
COPY --from=web /src/crates/reelix-web/dist /app/web
COPY --chmod=0755 docker/entrypoint.sh /app/entrypoint.sh

# Two glibc malloc arenas instead of up to eight per core. For headless use with Starboard as the only
# interface, set REELIX_WEB_DIR to an empty folder: Reelix then serves a short notice and the API as usual.
ENV REELIX_DATA_DIR=/config \
    REELIX_WEB_DIR=/app/web \
    REELIX_DOCKER=1 \
    MALLOC_ARENA_MAX=2 \
    PUID=1000 \
    PGID=1000 \
    UMASK=022

EXPOSE 7700
VOLUME /config
WORKDIR /app
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 CMD ["/app/reelix", "healthcheck"]
ENTRYPOINT ["/app/entrypoint.sh"]
