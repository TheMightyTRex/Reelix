# syntax=docker/dockerfile:1
# Release image built from the binaries the release workflow already compiled, so multi-arch
# images don't need a Rust build under emulation. The build context must contain:
#   bin/amd64/reelix, bin/arm64/reelix, web/ (trunk dist), docker/entrypoint.sh
# For a local from-source build, use docker/Dockerfile instead.

FROM debian:bookworm-slim
ARG TARGETARCH
ARG VERSION=dev

# util-linux (setpriv) is part of the base image; tzdata makes TZ work.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY bin/${TARGETARCH}/reelix /app/reelix
COPY web /app/web
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod 0755 /app/entrypoint.sh /app/reelix

LABEL org.opencontainers.image.title="Reelix" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

ENV REELIX_DATA_DIR=/config \
    REELIX_WEB_DIR=/app/web \
    REELIX_DOCKER=1 \
    PUID=1000 \
    PGID=1000 \
    UMASK=022

EXPOSE 7700
VOLUME /config
WORKDIR /app
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 CMD ["/app/reelix", "healthcheck"]
ENTRYPOINT ["/app/entrypoint.sh"]
